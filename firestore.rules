rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsUserDoc(userId);
      allow create: if ownsUserDoc(userId);
      allow update: if ownsUserDoc(userId);
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if ownsUserDoc(userId);
        allow create: if ownsUserDoc(userId)
          && request.resource.data.type in ["Income", "Expense"]
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.category is string
          && request.resource.data.date is string;
        allow update: if false;
        allow delete: if ownsUserDoc(userId);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
