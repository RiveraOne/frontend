{
  "name": "metrawealth-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore --project metrawealth-test 'vitest run tests/firestore-rules/'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "firebase-admin": "^13.8.0",
    "motion": "^12.34.3",
    "next": "^15.5.15",
    "openai": "^6.36.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.15",
    "jsdom": "^25.0.1",
    "postcss": "8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
